# Build outputs — regenerated by build.sh
dist/

# The batch CLI is single-sourced in skill/upstage-studio/scripts/upstage_batch.py.
# gui/upstage_batch.py is a build-time copy stamped in by build.sh; never edit
# it directly (edit the skill copy instead).
gui/upstage_batch.py

# Python cruft
__pycache__/
*.pyc

# Run outputs / logs / customer data — must never be committed
*.log
batch_output_*/
results/
summary.json
.checkpoint.json
*.report.html

# Secrets — never commit
*.rtf
*api*key*
.env

# OS cruft
.DS_Store
