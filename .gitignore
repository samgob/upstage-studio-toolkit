# Build outputs — regenerated by build.sh
dist/

# The batch CLI is single-sourced in core/. These are build-time copies
# stamped in by build.sh; never edit or commit them (edit core/ instead).
skill/upstage-studio/scripts/upstage_batch.py
gui/upstage_batch.py

# Python cruft
__pycache__/
*.pyc

# Run outputs / logs / customer data — must never be committed
*.log
batch_output_*/
results/
summary.json
.checkpoint.json
*.report.html

# Secrets — never commit
*.rtf
*api*key*
.env

# OS cruft
.DS_Store
